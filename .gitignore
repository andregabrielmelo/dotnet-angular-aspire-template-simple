# Backend and frontend have their own, more thorough .gitignore files.
# This one covers things that span the whole repo.

# Hugo docs site build output/theme (theme is cloned fresh by the hugo-docs workflow)
docs/public/
docs/themes/
docs/resources/
docs/.hugo_build.lock

# Husky.Net's internal hook-runner script + install stamp - regenerated by `dotnet husky install`
# (which runs automatically on `dotnet restore`, see Directory.Build.targets)
.husky/_/

# OS files
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/

# Angular CLI cache (when the CLI runs from the repo root)
.angular/
