{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "apptemplate",
    "Audience": "apptemplate-api",
    "SigningKey": "",
    "AccessTokenValidity": "00:15:00",
    "RefreshTokenValidity": "7.00:00:00",
    "RefreshCookiePath": "/api/auth/refresh-token"
  },
  "AllowedHosts": "*"
}
