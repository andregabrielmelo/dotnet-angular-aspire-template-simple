# For more info on HTTP files go to https://aka.ms/vs/httpfile
@host=http://localhost
@port=5234
# Every /users endpoint needs an access token: sign in below (the dev admin account is seeded
# in Development) and paste the response's accessToken here. It expires after 15 minutes.
@token=paste-an-access-token-here

// Sign in. The response also sets the refresh token cookie, used by the SPA's /auth/refresh.
POST {{host}}:{{port}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin123!"
}

###

// Register (and sign in) a new account
POST {{host}}:{{port}}/auth/register
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "ada@example.com",
  "password": "correct horse battery staple"
}

###

// List all users
GET {{host}}:{{port}}/users
Authorization: Bearer {{token}}

###

// Get a specific user
@id_to_get=1
GET {{host}}:{{port}}/users/{{id_to_get}}
Authorization: Bearer {{token}}

###

// Get the current user (the token's sub) and the permissions the token grants
GET {{host}}:{{port}}/users/me
Authorization: Bearer {{token}}

###

// Update a user
@id_to_update=3
PUT {{host}}:{{port}}/users/{{id_to_update}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": {{id_to_update}},
  "name": "ardalis2",
  "phoneNumber": "555 0100",
  "phoneCountryCode": "+1"
}

###

// Delete a user
@id_to_delete=1
DELETE {{host}}:{{port}}/users/{{id_to_delete}}
Authorization: Bearer {{token}}
