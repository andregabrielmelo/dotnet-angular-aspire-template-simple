# For more info on HTTP files go to https://aka.ms/vs/httpfile
#
# Requests against the API run by the AppHost (its https profile). The Angular app signs in with
# the session cookie, but every unsafe request from a session also needs an antiforgery token,
# so this file uses a bearer token from POST /auth/token instead (ADR 018), as any non-browser
# client would. The token expires after 15 minutes: run the token request again.
@host = https://localhost:7243

# Get a bearer token. The development admin account is seeded in Development.
# @name token
POST {{host}}/auth/token
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin123!"
}

###

@accessToken = {{token.response.body.$.accessToken}}

# Register a new account. It doesn't sign in: the API emails a confirmation link (read it in
# Mailpit, from the Aspire dashboard), and the account can sign in once it's confirmed.
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "ada@example.com",
  "password": "correct horse battery staple"
}

###

# Confirm the email with the userId and code from the link's query string.
POST {{host}}/auth/confirm-email
Content-Type: application/json

{
  "userId": 2,
  "code": "paste-the-code-from-the-link"
}

###

# Send another confirmation link. Always 202, whether or not the email has an account.
POST {{host}}/auth/resend-confirmation
Content-Type: application/json

{
  "email": "ada@example.com"
}

###

# The caller's profile and the permissions their roles grant
GET {{host}}/users/me
Authorization: Bearer {{accessToken}}

###

# List users (needs users:read)
GET {{host}}/users?page=1&per_page=10
Authorization: Bearer {{accessToken}}

###

# Get a user (needs users:read)
@id_to_get = 1
GET {{host}}/users/{{id_to_get}}
Authorization: Bearer {{accessToken}}

###

# Update a user: their own profile, or anyone's with users:write. Phone fields left out keep
# their saved value; the ones sent replace it. Send an empty phoneExtension to remove it.
@id_to_update = 1
PUT {{host}}/users/{{id_to_update}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Sample User",
  "phoneNumber": "555 0100",
  "phoneCountryCode": "+1"
}

###

# Delete a user (needs users:delete)
@id_to_delete = 2
DELETE {{host}}/users/{{id_to_delete}}
Authorization: Bearer {{accessToken}}
