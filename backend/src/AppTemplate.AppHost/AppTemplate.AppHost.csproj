<Project Sdk="Aspire.AppHost.Sdk/13.1.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>d2dcc3a3-5da1-4dfc-a6bf-2950502663fb</UserSecretsId>
    <!-- The Aspire SDK pulls OS-specific packages (Aspire.Dashboard.Sdk.<rid>, Aspire.Hosting.Orchestration.<rid>), so a lock file generated on one OS fails locked-mode restore on the others. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.NodeJS.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppTemplate.BackendForFrontend\AppTemplate.BackendForFrontend.csproj" />
    <ProjectReference Include="..\AppTemplate.Web\AppTemplate.Web.csproj" />
  </ItemGroup>
</Project>
