<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Like the AppHost: the Aspire packages are OS-specific (Aspire.Hosting.Orchestration.<rid>, ...), so a lock file generated on one OS fails locked-mode restore on the others. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestCategories.cs" Link="TestCategories.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppTemplate.AppHost\AppTemplate.AppHost.csproj" />
  </ItemGroup>
</Project>
