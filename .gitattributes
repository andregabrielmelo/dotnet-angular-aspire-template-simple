# Normalize line endings to LF for every text file, on every OS. backend/ already had this;
# without a repo-wide rule, Windows tools converted docs and frontend files to CRLF.
* text=auto eol=lf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
